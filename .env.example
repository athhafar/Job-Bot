# ============================================================
# Mobile Job Opportunity Bot - Environment Variables (.env)
# ============================================================

# 1. Google Gemini API Key (Gratis dari Google AI Studio)
# Dapatkan di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Model Gemini (Rekomendasi free tier: gemini-3.8-flash)
# Model Flash terbaru: gemini-3.8-flash
GEMINI_MODEL="gemini-3.8-flash"

# 3. Telegram Bot Token (Dapatkan dari @BotFather di Telegram)
# Format: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# 4. Telegram Chat ID Penerima Notifikasi
# Dapatkan ID akun Telegram Anda via bot @userinfobot atau @getmyid_bot
# Format angka (contoh: 123456789)
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"
