# ============================================================
# Mobile Job Opportunity Bot (Meta Threads) - Environment Variables
# ============================================================

# 1. Meta Threads API Credentials
# Dapatkan dari Meta for Developers > Threads App > User Token Generator
THREADS_ACCESS_TOKEN=ISI_ACCESS_TOKEN_DI_SINI
THREADS_APP_ID=ISI_THREADS_APP_ID_DI_SINI
THREADS_APP_SECRET=ISI_THREADS_APP_SECRET_DI_SINI

# 2. Google Gemini API Key & Model
# Dapatkan API Key gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=ISI_GEMINI_API_KEY_DI_SINI
# Model varian Flash-Lite hemat kuota free tier (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# 3. Telegram Bot Credentials
# Dapatkan Token dari @BotFather dan Chat ID dari @userinfobot
TELEGRAM_BOT_TOKEN=ISI_TELEGRAM_BOT_TOKEN_DI_SINI
TELEGRAM_CHAT_ID=ISI_TELEGRAM_CHAT_ID_DI_SINI
